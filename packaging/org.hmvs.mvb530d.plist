<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Print agent for MV-B530 class thermal printers.

    Installed to /Library/LaunchAgents by `sudo make install`, so it starts for
    whichever user logs in. It has to be a LaunchAgent rather than a
    LaunchDaemon: CoreBluetooth needs a GUI login session, and the Bluetooth
    TCC grant belongs to the user, not to root.

    Logs go to the unified log, not a file - a fixed path under /tmp would be
    shared between users and writable by anyone:

        log stream --predicate 'process == "mvb530d"' --info
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.hmvs.mvb530d</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/libexec/mvb530d</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <!-- Only in a real GUI session. In a plain SSH or system context there is
         no Bluetooth access to be had, and the process would just respawn. -->
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>

    <key>ProcessType</key>
    <string>Background</string>

    <!-- Idle most of the time; do not let a crash loop spin. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
